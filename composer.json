{
  "name": "tmswp/acf-bridge",
  "description": "TMStack WordPress Framework - ACF Bridge",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3",
    "tmswp/core": "^0.10"
  },
  "require-dev": {
    "tmswp/testing": "^0.10"
  },
  "suggest": {
    "advanced-custom-fields-pro": "ACF Pro 6.2+ をWPプラグインとして導入すること"
  },
  "bin": [
    "bin/tms-acf"
  ],
  "autoload": {
    "psr-4": {
      "TMSWP\\AcfBridge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TMSWP\\AcfBridge\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.10.x-dev"
    }
  },
  "minimum-stability": "stable",
  "config": {
    "sort-packages": true
  }
}
